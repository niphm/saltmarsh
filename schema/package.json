{
  "name": "@saltmarsh/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Saltmarsh data model: Zod schemas, rules engine, example characters",
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples.ts",
    "./examples/*.json": "./examples/*.json"
  },
  "scripts": {
    "validate": "tsx src/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
